{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npx serve:*)",
      "Bash(node --version)",
      "Bash(npm --version)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git remote -v)",
      "Bash(git ls-files:*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(npm install:*)",
      "Bash(npx:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.secret)",
      "Read(./**/*.key)",
      "Read(./**/*.pem)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(./**/*.secret)",
      "Edit(./**/*.key)",
      "Edit(./**/*.pem)",
      "Write(./.env)",
      "Write(./.env.*)",
      "Write(./**/*.secret)",
      "Write(./**/*.key)",
      "Write(./**/*.pem)"
    ]
  }
}
