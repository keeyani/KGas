# Keep LF in the working tree on every platform.
#
# build.mjs compares generated output byte-for-byte against the committed
# HTML. If git rewrote line endings to CRLF on checkout, `node build.mjs
# --check` would report every page stale on a fresh Windows clone, because
# the build itself writes LF.
* text=auto eol=lf

# Binary assets must never be touched.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.pdf  binary
*.woff binary
*.woff2 binary
